---
import Base from '~/layouts/Base.astro';
import { fetchOne, fetchMany, sanityConfigured } from '~/lib/sanity';
import { siteSettingsQuery, journalListQuery, journalPostBySlugQuery } from '~/lib/queries';
import { renderRichText, renderInline } from '~/lib/portableText';
import { imgUrl, imgAlt } from '~/lib/image';
import type { SiteSettings, JournalPost } from '~/types';

export async function getStaticPaths() {
  const { fetchMany, sanityConfigured } = await import('~/lib/sanity');
  const { journalListQuery } = await import('~/lib/queries');
  if (!sanityConfigured) return [];
  const posts = await fetchMany<JournalPost>(journalListQuery);
  return posts.map((p) => ({ params: { slug: p.slug.current } }));
}

const { slug } = Astro.params;
const [settings, post] = await Promise.all([
  fetchOne<SiteSettings>(siteSettingsQuery),
  fetchOne<any>(journalPostBySlugQuery, { slug }),
]);

if (!post) {
  return Astro.redirect('/404', 404);
}

const dateText = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const heroSrc = imgUrl(post.heroImage);
const heroAlt = imgAlt(post.heroImage, post.title);
const bodyHtml = renderRichText(post.body);

const pageTitle = post.seo?.title ?? `${post.title} | Journal | Glass Garden Rooms`;
const pageDesc  = post.seo?.description ?? post.excerpt ?? '';
---
<Base title={pageTitle} description={pageDesc} seo={post.seo} settings={settings} ogImageUrl={heroSrc}>

<article class="wrap" style="padding-top: var(--s-7); padding-bottom: var(--s-7); max-width: 75ch;">
  <div class="page-head-row" style="margin-bottom: var(--s-5);">
    <span class="breadcrumb">— Journal</span>
    {post.volumeNumber && <span class="label" style="text-align:center;">{post.volumeNumber}</span>}
    {dateText && <span class="label">{dateText}</span>}
  </div>
  <h1>{post.title}</h1>
  {post.excerpt && <p class="lede">{post.excerpt}</p>}

  {heroSrc && (
    <figure class="hero-image" style="margin-top: var(--s-6); max-height: 60vh;">
      <img src={heroSrc} alt={heroAlt} />
      {post.heroImage?.caption && <figcaption class="hero-caption">— {post.heroImage.caption}</figcaption>}
    </figure>
  )}

  <div class="journal-body-text" style="margin-top: var(--s-7); font-size: 1.05rem; line-height: 1.75;" set:html={bodyHtml} />

  {post.relatedProducts?.length > 0 && (
    <section class="section-tight" style="margin-top: var(--s-7); padding-top: var(--s-6); border-top: 1px solid var(--line);">
      <span class="eyebrow">Mentioned in this piece</span>
      <div class="collection" style="margin-top: var(--s-5);">
        {post.relatedProducts.map((p: any) => (
          <a class="card" href={`/products/${p.slug.current}/`}>
            <div class="card-media">
              <img loading="lazy" src={imgUrl(p.heroImage)} alt={imgAlt(p.heroImage, p.name)} />
            </div>
            <div class="card-body">
              <h3 class="card-title">{p.name}</h3>
              {p.strapline && <p class="card-desc">{p.strapline}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</article>

<section class="section">
  <div class="wrap text-center">
    <a class="btn btn-ghost" href="/journal/">← Back to the Journal</a>
  </div>
</section>

</Base>
