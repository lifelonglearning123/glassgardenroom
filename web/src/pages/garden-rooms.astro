---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery } from '~/lib/queries';
import type { SiteSettings } from '~/types';

const settings = await fetchOne<SiteSettings>(siteSettingsQuery);

const title = 'Glass Garden Rooms — Premium & hup! System | Glass Garden Rooms';
const description = 'Fully-enclosed glass garden rooms with 10mm safety-glass sliders. From £18,000. Year-round comfort, 360° views, 5-year warranty. Or build 5× faster with the hup! system.';
---
<Base title={title} description={description} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">— Catalogue / Glass Garden Rooms</span>
    <span class="label" style="text-align:center;">Year-round living</span>
    <span class="label">From £18,000</span>
  </div>
  <h1>An <em>extension</em>, made of light.</h1>
  <p class="lede">
    A glass garden room is a fully-enclosed, year-round room — the kind of place
    you read on a Sunday morning, work from on a Tuesday afternoon, and dine in
    on the kind of October evening when the leaves catch the last sun.
  </p>
</section>

<section class="wrap" style="padding-top: var(--s-7);">
  <figure class="hero-image" style="max-height: 70vh;">
    <img src="/images/69af57437c270219ab46766e.jpeg" alt="A premium fully-enclosed glass garden room with chandelier-style lighting at a modern wood-clad home" />
  </figure>
  <p class="hero-caption">— The Premium Glass Room in matt anthracite, photographed at dusk.</p>
</section>

<section class="wrap section-tight">
  <div class="stack">
    <figure class="stack-major">
      <img loading="lazy" src="/images/glass%20garden%20room%20Toulouse%20Glass%20Garden%20Room.jpg" alt="Premium fully-enclosed glass garden room beside a modern white house" />
    </figure>
    <div class="stack-minors">
      <figure class="stack-minor">
        <img loading="lazy" src="/images/glass%20garden%20room%202.JPG" alt="Glass garden room interior overlooking a river" />
      </figure>
      <figure class="stack-minor">
        <img loading="lazy" src="/images/glass%20garden%20room%203.jpg" alt="Premium glass garden room beside a swimming pool" />
      </figure>
    </div>
  </div>
</section>

<section class="moment">
  <div class="moment-bg" style="background-image: url('/images/69af64878d3eae103bbd3777.jpg');"></div>
  <div class="moment-inner">
    <span class="eyebrow">Year-round · 18°C inside</span>
    <h2 class="moment-h">A room that earns its keep on the <em class="italic-display">worst</em> nights, not the best.</h2>
    <p class="moment-text">
      10mm tempered glass, aluminium, and a roof that turns rainfall
      into music. Sit out the storm. Watch the garden change colour for free.
    </p>
  </div>
</section>

<section class="section wrap">
  <div class="editorial">
    <div class="editorial-text reveal">
      <span class="eyebrow">№ 01 · Premium Glass Room</span>
      <h2 class="h2 mt-4">Quietly engineered. <em class="italic-display">Endlessly bespoke.</em></h2>
      <p class="lede mt-5">
        Our flagship glass garden room. Designed around your space, sized to the
        millimetre, and built from the same materials we'd choose for our own homes.
      </p>
      <ul class="bullets">
        <li><span>10mm safety-glass sliding doors</span></li>
        <li><span>8.8mm laminated glass roof</span></li>
        <li><span>aluminium frame</span></li>
        <li><span>360° views, locking handles</span></li>
        <li><span>Bespoke sizing — no module limits</span></li>
        <li><span>3–6 day installation</span></li>
      </ul>
      <p style="margin-top: var(--s-6);"><span class="card-price serif" style="font-size:1.2rem;">From £18,000</span></p>
      <div class="mt-6"><a class="btn btn-primary" href="/contact/">Request a Premium quote <span class="arrow">→</span></a></div>
    </div>
    <div class="editorial-image reveal">
      <img src="/images/69935c6a1eb3cf2a9dd115a1.jpg" alt="Bright glass garden room interior with sliders, sectional sofa, dining table and views to the garden" />
    </div>
  </div>
</section>

<hr class="divider" />

<section class="section wrap">
  <div class="editorial editorial-flip">
    <div class="editorial-text reveal">
      <span class="eyebrow">№ 02 · The hup! System</span>
      <h2 class="h2 mt-4">A genuine extension, <em class="italic-display">five times faster.</em></h2>
      <p class="lede mt-5">
        Where a glass room ends and a real extension begins. The hup! system uses
        super-insulated wall panels and a choice of glass or solid roofing — giving
        you a year-round room without the months of building works.
      </p>
      <ul class="bullets">
        <li><span>Super-insulated wall panels</span></li>
        <li><span>Glass or solid roof options</span></li>
        <li><span>Permitted-development friendly</span></li>
        <li><span>Modular, extendable in future</span></li>
        <li><span>Built-in service voids for power</span></li>
        <li><span>5× faster than masonry</span></li>
      </ul>
      <div class="mt-6"><a class="btn btn-moss" href="/contact/">Request the hup! brochure <span class="arrow">→</span></a></div>
    </div>
    <div class="editorial-image reveal">
      <img src="/images/69935d816bac2409fbd2cdd5.png" alt="hup! brochure showing conservatory transformations and the hup! extension system" />
    </div>
  </div>
</section>

<div class="marquee" aria-label="Glass room recent installs">
  <div class="marquee-track">
    <figure class="marquee-tile"><img loading="lazy" src="/images/69af648713dc9c65234e9b6c.jpg" alt="Glass room beside red brick home" /><figcaption class="marquee-tile-cap">Leicester</figcaption></figure>
    <figure class="marquee-tile"><img loading="lazy" src="/images/69af64878d3eae103bbd3777.jpg" alt="Glass room with forest view" /><figcaption class="marquee-tile-cap">Forest edge</figcaption></figure>
    <figure class="marquee-tile"><img loading="lazy" src="/images/69935c6a0978098fe5591d5b.jpg" alt="Glass room interior with sectional sofa" /><figcaption class="marquee-tile-cap">Coventry</figcaption></figure>
    <figure class="marquee-tile"><img loading="lazy" src="/images/69af5ac04a2d885a97eda736.jpg" alt="Canalside glass garden room" /><figcaption class="marquee-tile-cap">Oxford</figcaption></figure>
    <figure class="marquee-tile"><img loading="lazy" src="/images/699505855c226558b0fec04a.jpg" alt="Sunlit glass enclosure interior" /><figcaption class="marquee-tile-cap">Solihull</figcaption></figure>
    <figure class="marquee-tile"><img loading="lazy" src="/images/6996ba230a9114a48ef3a39e.jpeg" alt="Glass extension with sliding wall" /><figcaption class="marquee-tile-cap">Birmingham</figcaption></figure>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <header class="section-head">
      <span class="num">№ 03</span>
      <h2 class="title">A specification, in writing.</h2>
      <span class="meta">Glass · Frame · Coating</span>
    </header>

    <table class="spec-table">
      <tbody>
        <tr><th>Roof</th><td>8.8mm laminated safety glass — meets industry standards for impact resistance and safety</td></tr>
        <tr><th>Sliding doors</th><td>10mm tempered safety glass, stainless steel locking handles, multi-point locks</td></tr>
        <tr><th>Frame</th><td>6063-T6 aluminium — premium architectural grade, exceptional strength-to-weight</td></tr>
        <tr><th>Coating</th><td>Coat in Black, Dark Grey, Traffic White or Cream (custom RAL on request)</td></tr>
        <tr><th>Wall options</th><td>Sliding glass, fixed glass, aluminium panels, louvred sides</td></tr>
        <tr><th>Heating</th><td>Infrared / electric radiant panels, freestanding or wall-mounted (≥350mm clearance from glass)</td></tr>
        <tr><th>Lighting</th><td>Integrated LED downlights, smart-control compatible</td></tr>
        <tr><th>Blinds</th><td>Motorised internal or external roof blinds — remote or weather-sensor</td></tr>
        <tr><th>Warranty</th><td>5 years on structure and materials, with extended warranties available</td></tr>
        <tr><th>Lead time</th><td>4–6 weeks from confirmed order</td></tr>
        <tr><th>Install</th><td>3–6 days, depending on size and complexity</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 18ch; margin-inline: auto;">Begin with a <em class="italic-display">conversation.</em></h2>
    <p class="lede mt-5" style="margin-inline: auto;">
      Send us a photo of your wall, your rough dimensions, and what you're imagining — we'll come back with a quote within two working days.
    </p>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href="/contact/">Request a quote <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://wa.me/447398224061">WhatsApp 07398 224061</a>
    </div>
  </div>
</section>

</Base>
