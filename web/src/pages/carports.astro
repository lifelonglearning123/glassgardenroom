---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery } from '~/lib/queries';
import type { SiteSettings } from '~/types';

const settings = await fetchOne<SiteSettings>(siteSettingsQuery);

const title = 'Carports & Canopies — From £2,500 | Glass Garden Rooms';
const description = 'Aluminium carports and canopies with 18mm polycarbonate roofing and integrated guttering. Single, double or bespoke. From £2,500.';
---
<Base title={title} description={description} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">— Catalogue / Carports</span>
    <span class="label" style="text-align:center;">Single · Double · Bespoke</span>
    <span class="label">From £2,500</span>
  </div>
  <h1>Shelter, <em>refined.</em></h1>
  <p class="lede">
    A carport is a quietly useful piece of architecture — keeping a car dry, a doorway sheltered,
    a delivery out of the rain. Ours are built from the same aluminium as our verandas, with
    integrated guttering and 18mm triple-wall polycarbonate.
  </p>
</section>

<section class="wrap" style="padding-top: var(--s-7);">
  <figure class="hero-image" style="max-height: 70vh;">
    <img src="/images/69931cd51a38a0e65b65cf24.jpeg" alt="A modern aluminium carport with motorbikes parked underneath" />
  </figure>
  <p class="hero-caption">— A bespoke double-bay carport in matt anthracite, photographed in Rugby.</p>
</section>

<section class="section wrap">
  <header class="section-head">
    <span class="num">№ 01</span>
    <h2 class="title">Three sizes, one frame language.</h2>
    <span class="meta">From £2,500</span>
  </header>

  <div class="collection">
    <div class="card reveal">
      <div class="card-media">
        <span class="card-tag">Single</span>
        <img loading="lazy" src="/images/69931cd51a38a0e65b65cf24.jpeg" alt="Single-bay aluminium carport with anthracite frame" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Single Carport</h3>
        <span class="card-price">from £2,500</span>
        <p class="card-desc">A clean, single-bay shelter for one vehicle. 3m × 5m typical, 18mm polycarbonate roof, integrated gutter.</p>
      </div>
    </div>
    <div class="card reveal">
      <div class="card-media">
        <span class="card-tag">Double</span>
        <img loading="lazy" src="/images/69af5ac0ace64743f2f64f40.jpg" alt="Aerial view of a double-span aluminium roof with concealed gutters" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Double Carport</h3>
        <span class="card-price">from £4,200</span>
        <p class="card-desc">A wider span for two vehicles or a generous covered approach. Twin-post or single-post bespoke options.</p>
      </div>
    </div>
    <div class="card reveal">
      <div class="card-media">
        <span class="card-tag">Bespoke</span>
        <img loading="lazy" src="/images/69af5ac08d3eaec669bc1f45.jpg" alt="A long covered canopy in matt anthracite extending across a paved area" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Bespoke &amp; Canopies</h3>
        <span class="card-price">on request</span>
        <p class="card-desc">Door canopies, walkways, EV-charging covers, multi-bay structures — sized to your space.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="editorial">
      <div class="editorial-image reveal">
        <img src="/images/69af5ac0ace64743f2f64f40.jpg" alt="Aerial detail of an aluminium glass-roof system showing concealed guttering and rafter spacing" />
      </div>
      <div class="editorial-text reveal">
        <span class="eyebrow">Why our carports</span>
        <h2 class="h2 mt-4">Built to <em class="italic-display">outlast</em> the car beneath it.</h2>
        <ul class="bullets">
          <li><span>6063-T6 aluminium frame</span></li>
          <li><span>18mm triple-wall polycarbonate</span></li>
          <li><span>Integrated guttering &amp; downpipes</span></li>
          <li><span>Optional LED lighting</span></li>
          <li><span>10-year structural warranty available</span></li>
          <li><span>1–2 day installation</span></li>
        </ul>
        <div class="mt-6"><a class="btn btn-primary" href="/contact/">Request a carport quote <span class="arrow">→</span></a></div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 16ch; margin-inline: auto;">A free survey, on your driveway.</h2>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href="/contact/">Book a survey <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="tel:02475102899">024 7510 2899</a>
    </div>
  </div>
</section>

</Base>
