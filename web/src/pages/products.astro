---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery } from '~/lib/queries';
import type { SiteSettings } from '~/types';

const settings = await fetchOne<SiteSettings>(siteSettingsQuery);

const title = 'The Catalogue — Glass Garden Rooms';
const description = 'Browse the full Glass Garden Rooms collection — verandas, glass garden rooms, carports and accessories. From £2,500.';
---
<Base title={title} description={description} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">— Catalogue, Vol. 01</span>
    <span class="label" style="text-align:center;">The Collection 2026</span>
    <span class="label">Six pieces</span>
  </div>
  <h1>The <em>catalogue.</em></h1>
  <p class="lede">
    A small, considered range of aluminium architecture — every piece engineered for British weather,
    built to last decades, and priced honestly all year round.
  </p>
</section>

<section class="section wrap">
  <header class="section-head">
    <span class="num">№ 01</span>
    <h2 class="title">Three families.</h2>
    <span class="meta">From £2,500</span>
  </header>

  <div class="collection">
    <a class="card reveal" href="/verandas/">
      <div class="card-media">
        <span class="card-tag">01 · Veranda</span>
        <img loading="lazy" src="/images/68c299cb43ec1c230ea3109a.jpeg" alt="Anthracite glass-roofed veranda over a stone-paved patio" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Verandas</h3>
        <span class="card-price">from £4,000</span>
        <p class="card-desc">A roof with a view. Glass or polycarbonate, attached or freestanding, 1–2 day install.</p>
        <span class="card-link">Provence · Bordeaux →</span>
      </div>
    </a>

    <a class="card reveal" href="/garden-rooms/">
      <div class="card-media">
        <span class="card-tag">02 · Garden Room</span>
        <img loading="lazy" src="/images/glass%20garden%20room%20Toulouse%20Glass%20Garden%20Room.jpg" alt="Premium fully-enclosed glass garden room beside a modern white house" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Glass Garden Rooms</h3>
        <span class="card-price">from £18,000</span>
        <p class="card-desc">A fully-enclosed extension with 10mm safety-glass sliders and a year-round climate.</p>
        <span class="card-link">Premium →</span>
      </div>
    </a>

    <a class="card reveal" href="/carports/">
      <div class="card-media">
        <span class="card-tag">03 · Carport</span>
        <img loading="lazy" src="/images/69931cd51a38a0e65b65cf24.jpeg" alt="A modern aluminium carport with motorbikes parked underneath" />
      </div>
      <div class="card-body">
        <h3 class="card-title">Carports & Canopies</h3>
        <span class="card-price">from £2,500</span>
        <p class="card-desc">18mm polycarbonate roofing, integrated guttering, single, double or bespoke.</p>
        <span class="card-link">Single · Double · Bespoke →</span>
      </div>
    </a>
  </div>
</section>

<hr class="divider" />

<section class="section wrap">
  <header class="section-head">
    <span class="num">№ 02</span>
    <h2 class="title">A specification, side by side.</h2>
    <span class="meta">Materials · Glass · Warranty</span>
  </header>

  <div style="overflow-x:auto;">
    <table class="spec-table">
      <thead>
        <tr><th>—</th><th><span class="card-title">Verandas</span></th><th><span class="card-title">Garden Rooms</span></th><th><span class="card-title">Carports</span></th></tr>
      </thead>
      <tbody>
        <tr><th>Starting price</th><td><span class="price">from £4,000</span></td><td><span class="price">from £18,000</span></td><td><span class="price">from £2,500</span></td></tr>
        <tr><th>Roof</th><td>8.8mm laminated glass<br/>or 18mm polycarbonate</td><td>8.8mm laminated glass</td><td>18mm polycarbonate</td></tr>
        <tr><th>Walls / sides</th><td>Open · optional sides</td><td>10mm safety-glass sliders, fixed glass or aluminium</td><td>Open</td></tr>
        <tr><th>Frame</th><td>6063-T6 aluminium</td><td>6063-T6 aluminium</td><td>6063-T6 aluminium</td></tr>
        <tr><th>Finishes</th><td colspan="3">Black · Dark Grey · Traffic White · Cream · custom RAL on request</td></tr>
        <tr><th>Coating</th><td colspan="3">AkzoNobel powder-coat</td></tr>
        <tr><th>Install time</th><td>1–2 days</td><td>3–6 days</td><td>1–2 days</td></tr>
        <tr><th>Warranty</th><td>5 years</td><td>5 years</td><td>5 years (10 on selected ranges)</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <header class="section-head">
      <span class="num">№ 03</span>
      <h2 class="title">Accessories &amp; finishing touches.</h2>
      <span class="meta">Specified at survey</span>
    </header>

    <div class="collection">
      <div class="card">
        <div class="card-media">
          <span class="card-tag">Blinds</span>
          <img loading="lazy" src="/images/69935c6a3b3cc9682bf257af.jpg" alt="Motorised pleated roof blind on a glass-roofed veranda" />
        </div>
        <div class="card-body">
          <h3 class="card-title">Motorised Blinds</h3>
          <span class="card-price">from £150</span>
          <p class="card-desc">Roof-mounted (internal or external), Somfy motors, remote or manual operation. Optional weather sensors.</p>
        </div>
      </div>

      <div class="card">
        <div class="card-media">
          <span class="card-tag">Heat &amp; Light</span>
          <img loading="lazy" src="/images/6995be7fb3d5f867f5477389.jpg" alt="Warm room interior with sophisticated lighting and blinds" />
        </div>
        <div class="card-body">
          <h3 class="card-title">Heating &amp; Lighting</h3>
          <span class="card-price">from £300</span>
          <p class="card-desc">Infrared and electric radiant panels, integrated LED downlights, smart-control compatible.</p>
        </div>
      </div>

      <div class="card">
        <div class="card-media">
          <span class="card-tag">Floor</span>
          <img loading="lazy" src="/images/6995bef5905d470929a4139a.webp" alt="Outdoor kitchen and dining area beneath a covered pergola" />
        </div>
        <div class="card-body">
          <h3 class="card-title">Flooring &amp; Landscaping</h3>
          <span class="card-price">on request</span>
          <p class="card-desc">Porcelain, natural stone, composite decking, outdoor kitchens — coordinated with your build.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section wrap">
  <div class="editorial">
    <div class="editorial-text reveal">
      <span class="eyebrow">№ 04 · Design tool</span>
      <h2 class="h2 mt-4">See it before you <em class="italic-display">build it.</em></h2>
      <p class="lede mt-5">
        Use our 3D configurator to shape your veranda — size, profile, glass, colour and roofing —
        and get an instant indicative price. A useful starting point before our surveyor turns up
        with samples in hand.
      </p>
      <div class="mt-6">
        <a class="btn btn-primary" href="https://configurator.alfresko.co.uk/?dealerId=0c65eea4-80d9-4a26-b81f-0ef4e0659bd9" target="_blank" rel="noopener">
          Open the 3D configurator <span class="arrow">→</span>
        </a>
      </div>
    </div>
    <div class="editorial-image reveal">
      <img loading="lazy" src="/images/68c299cb43ec1c230ea3109a.jpeg" alt="Anthracite aluminium veranda — the kind of build you can shape in our 3D configurator" />
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 18ch; margin-inline: auto;">A bespoke quote, by tomorrow.</h2>
    <p class="lede mt-5" style="margin-inline: auto;">
      Send us your width, projection and a photo of the wall — we'll come back with an honest figure within two working days.
    </p>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href="/contact/">Request a quote <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://configurator.alfresko.co.uk/?dealerId=0c65eea4-80d9-4a26-b81f-0ef4e0659bd9" target="_blank" rel="noopener">Instant Price <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="/assets/glass-garden-rooms-brochure.pdf" download>Download the brochure <small style="opacity:.65;">(PDF · 13MB)</small></a>
      <a class="btn btn-ghost" href="https://wa.me/447398224061">WhatsApp survey</a>
    </div>
  </div>
</section>

</Base>
