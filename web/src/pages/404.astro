---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery } from '~/lib/queries';
import type { SiteSettings } from '~/types';

const settings = await fetchOne<SiteSettings>(siteSettingsQuery);
---
<Base title="Page not found | Glass Garden Rooms" description="The page you were looking for couldn't be found." settings={settings}>

<section class="section wrap text-center" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center;">
  <span class="eyebrow" style="justify-content: center;">404</span>
  <h1 class="display mt-5" style="max-width: 20ch; margin-inline: auto;">
    A page that <em class="italic-display">isn't.</em>
  </h1>
  <p class="lede mt-5" style="margin-inline: auto; max-width: 50ch;">
    We've moved, renamed or politely shown the door to whatever you were looking for. Try the catalogue, or send us a quick message.
  </p>
  <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
    <a class="btn btn-primary" href="/">Back to the home page <span class="arrow">→</span></a>
    <a class="btn btn-ghost" href="/products/">The catalogue</a>
    <a class="btn btn-ghost" href="/contact/">Contact</a>
  </div>
</section>

</Base>
