---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery, installationPageQuery } from '~/lib/queries';
import { renderInline, renderRichText } from '~/lib/portableText';
import { imgUrl } from '~/lib/image';
import type { SiteSettings } from '~/types';

const [settings, page] = await Promise.all([
  fetchOne<SiteSettings>(siteSettingsQuery),
  fetchOne<any>(installationPageQuery),
]);

const head = page?.pageHead;
const breadcrumb = head?.breadcrumb ?? '— Service / Installation';
const labelMid   = head?.label      ?? 'Approved & vetted teams';
const headline   = head?.headline ? renderInline(head.headline) : 'Installed by the people who <em>built</em> it.';
const lede       = head?.lede     ?? 'Every Glass Garden Rooms project is fitted by an approved installation team — vetted, trained, and accountable to us. Minimal disruption, careful workmanship, and a tidy site at the end.';

const steps = page?.steps?.length ? page.steps : [
  { number: 'i.',   title: 'Survey & preparation',     bodyHtml: 'Free on-site survey (45 min – 2 hrs). Ground levelling, base prep, planning paperwork where needed. Remote WhatsApp surveys available outside the Midlands.' },
  { number: 'ii.',  title: 'Structure assembly',       bodyHtml: 'Aluminium frame and roof installed with weatherproof seals. Foundation anchoring. Electrical first-fix integrated where required.' },
  { number: 'iii.', title: 'Accessories & finishing',  bodyHtml: 'Sliding doors, motorised blinds, LED lighting, infrared heating — fitted and tested. Final adjustments and snagging.' },
  { number: 'iv.',  title: 'Handover & aftercare',     bodyHtml: 'Full walk-through, maintenance notes, written 5-year warranty in your inbox. We tidy up before we leave.' },
];

const renderStepBody = (s: any) => s.bodyHtml ?? renderRichText(s.body) ?? '';

const pageTitle = page?.seo?.title ?? 'Installation — Hassle-free, in 1–6 days | Glass Garden Rooms';
const pageDesc  = page?.seo?.description ?? 'Professional installation of verandas, glass garden rooms and carports across the Midlands and the UK. 4-step process, 1–6 day install, 5-year warranty.';
---
<Base title={pageTitle} description={pageDesc} seo={page?.seo} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">{breadcrumb}</span>
    <span class="label" style="text-align:center;">{labelMid}</span>
    <span class="label">1–6 days on site</span>
  </div>
  <h1 set:html={headline} />
  <p class="lede">{lede}</p>
</section>

<section class="wrap" style="padding-top: var(--s-7);">
  <figure class="hero-image" style="max-height: 60vh;">
    <img src="/images/697cdafd1fd827dd1fed5211.jpeg" alt="An installer carefully fitting a fascia detail on a finished veranda" />
  </figure>
  <p class="hero-caption">— Final fascia, day two of a Coventry install.</p>
</section>

<section class="section wrap">
  <header class="section-head">
    <span class="num">№ 01</span>
    <h2 class="title">Four steps, no surprises.</h2>
    <span class="meta">Lead time 4–6 weeks</span>
  </header>

  <div class="process">
    {steps.map((s: any) => (
      <div class="process-step reveal">
        <span class="num">{s.number}</span>
        <h4>{s.title}</h4>
        <p set:html={renderStepBody(s)} />
      </div>
    ))}
  </div>
</section>

<hr class="divider" />

<section class="section wrap">
  <div class="editorial">
    <div class="editorial-text reveal">
      <span class="eyebrow">What's included</span>
      <h2 class="h2 mt-4">Everything you'd expect — and a few things you wouldn't.</h2>
      <ul class="bullets">
        <li><span>Free on-site survey</span></li>
        <li><span>Ground prep &amp; levelling</span></li>
        <li><span>Permit advice</span></li>
        <li><span>Frame &amp; structure assembly</span></li>
        <li><span>Glass &amp; roofing fit</span></li>
        <li><span>Foundation anchoring</span></li>
        <li><span>Electrical first-fix integration</span></li>
        <li><span>Door, blind, LED &amp; heater install</span></li>
        <li><span>Quality checks &amp; site clean</span></li>
        <li><span>Full handover walk-through</span></li>
        <li><span>Maintenance pack</span></li>
        <li><span>Five-year warranty in writing</span></li>
      </ul>
    </div>
    <div class="editorial-image reveal">
      <img src="/images/6996391bad0053480aa2bec9.jpeg" alt="Two installers building an aluminium veranda frame at the rear of a brick home" />
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 18ch; margin-inline: auto;">Schedule your <em class="italic-display">installation.</em></h2>
    <p class="lede mt-5" style="margin-inline: auto;">Lead times are typically 4–6 weeks. Most of our popular verandas are in stock for faster turnarounds.</p>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href="/contact/">Book a survey <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="tel:02475102899">024 7510 2899</a>
    </div>
  </div>
</section>

</Base>
