---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery } from '~/lib/queries';
import type { SiteSettings } from '~/types';

const settings = await fetchOne<SiteSettings>(siteSettingsQuery);

const title = 'Verandas — Provence & Bordeaux | Glass Garden Rooms';
const description = 'Bespoke aluminium verandas with glass or polycarbonate roofing. The Provence (glass) and Bordeaux (polycarbonate). From £4,000. 1–2 day install.';
---
<Base title={title} description={description} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">— Catalogue / Verandas</span>
    <span class="label" style="text-align:center;">Two profiles</span>
    <span class="label">From £4,000</span>
  </div>
  <h1>A roof, with a <em>view.</em></h1>
  <p class="lede">
    A veranda is the simplest piece of architecture you can add to a home — open-sided,
    weather-tight, and quietly transformative. Ours are built from 6063-T6 aluminium with
    a choice of laminated-glass or triple-wall polycarbonate roofing.
  </p>
</section>

<section class="wrap" style="padding-top: var(--s-7);">
  <figure class="hero-image" style="max-height: 70vh;">
    <img src="/images/68c299cb43ec1c230ea3109a.jpeg" alt="Anthracite aluminium veranda over a stone-paved patio with corner sofa, brick home behind, lawn beyond" />
  </figure>
  <p class="hero-caption">— The Provence in matt anthracite, photographed in Solihull, March 2026.</p>
</section>

<section class="moment" style="margin-top: var(--s-7);">
  <div class="moment-bg" style="background-image: url('/images/69af5ac0ace64743f2f64f40.jpg');"></div>
  <div class="moment-inner">
    <span class="eyebrow">A Veranda · in detail</span>
    <h2 class="moment-h">A roof you don't <em class="italic-display">have to think about</em> ever again.</h2>
    <p class="moment-text">
      8.8mm laminated safety glass, set into 6063-T6 aluminium rafters with concealed
      gutters and silent self-cleaning falls. Engineered to outlast the house it leans on.
    </p>
  </div>
</section>

<section class="section wrap">
  <div class="editorial">
    <div class="editorial-text reveal">
      <span class="eyebrow">№ 01 · The Provence</span>
      <h2 class="h2 mt-4"><em class="italic-display">Glass</em> roof. Maximum light.</h2>
      <p class="lede mt-5">
        The Provence is our glass-roofed veranda — designed for those moments when the
        weather isn't quite cooperating but you still want to feel like you're outside.
      </p>
      <ul class="bullets">
        <li><span>8.8mm laminated safety glass roof</span></li>
        <li><span>6063-T6 aluminium frame</span></li>
        <li><span>Integrated guttering and downpipes</span></li>
        <li><span>Wall-mounted or freestanding</span></li>
        <li><span>Optional sliding-glass side walls</span></li>
        <li><span>Optional LED lighting and infrared heat</span></li>
      </ul>
      <p style="margin-top: var(--s-6);"><span class="card-price serif" style="font-size:1.2rem;">From £4,000</span></p>
      <div class="flex gap-3 flex-wrap mt-6">
        <a class="btn btn-primary" href="/contact/">Request a Provence quote <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="https://configurator.alfresko.co.uk/?dealerId=0c65eea4-80d9-4a26-b81f-0ef4e0659bd9" target="_blank" rel="noopener">Instant Price <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="editorial-image reveal">
      <img src="/images/6996ba230a9114a48ef3a39e.jpeg" alt="The Provence glass-roofed veranda with sliding wall and orange chair" />
    </div>
  </div>
</section>

<section class="section-tight wrap">
  <div class="mosaic">
    <figure class="m1"><img loading="lazy" src="/images/69935c6a3b3cc9652ef257ae.jpeg" alt="Veranda over decking with garden steps and woodland behind" /><figcaption>The Provence · Stratford</figcaption></figure>
    <figure class="m2"><img loading="lazy" src="/images/69af5ac0bfc81f32852b76c3.jpg" alt="Veranda over patio with grass area and fence" /><figcaption>Coventry</figcaption></figure>
    <figure class="m3"><img loading="lazy" src="/images/697cdafd1311f6c222f0b348.jpeg" alt="Anthracite veranda on rear of brick home" /><figcaption>Leicester</figcaption></figure>
    <figure class="m4"><img loading="lazy" src="/images/69af5ac08d3eaec669bc1f45.jpg" alt="Long veranda with adirondack chairs" /><figcaption>Northampton</figcaption></figure>
    <figure class="m5"><img loading="lazy" src="/images/69af5eaf7c270212a8475716.jpeg" alt="White modern home with veranda" /><figcaption>Reading</figcaption></figure>
    <figure class="m6"><img loading="lazy" src="/images/6995be7fb3d5f8d93347737f.jpeg" alt="Anthracite veranda over patio with sofa" /><figcaption>Solihull</figcaption></figure>
  </div>
</section>

<hr class="divider" />

<section class="section wrap">
  <div class="editorial editorial-flip">
    <div class="editorial-text reveal">
      <span class="eyebrow">№ 02 · The Bordeaux</span>
      <h2 class="h2 mt-4"><em class="italic-display">Polycarbonate.</em> Honest value.</h2>
      <p class="lede mt-5">
        The Bordeaux uses 16mm triple-wall polycarbonate in place of glass — lighter,
        more affordable, and excellent at diffusing harsh midday sun.
      </p>
      <ul class="bullets">
        <li><span>16mm triple-wall polycarbonate</span></li>
        <li><span>Clear, Opal, Solar Control or Ultra-Clear</span></li>
        <li><span>UV protection across the spectrum</span></li>
        <li><span>Quieter rainfall than acrylic</span></li>
        <li><span>Faster lead time, often in stock</span></li>
        <li><span>Five-year structural warranty</span></li>
      </ul>
      <p style="margin-top: var(--s-6);"><span class="card-price serif" style="font-size:1.2rem;">From £4,000</span></p>
      <div class="flex gap-3 flex-wrap mt-6">
        <a class="btn btn-primary" href="/contact/">Request a Bordeaux quote <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="https://configurator.alfresko.co.uk/?dealerId=0c65eea4-80d9-4a26-b81f-0ef4e0659bd9" target="_blank" rel="noopener">Instant Price <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="editorial-image reveal">
      <img src="/images/69935c6a6bac24658ed28f95.jpeg" alt="A compact polycarbonate veranda over a small patio with garden pond" />
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <header class="section-head">
      <span class="num">№ 03</span>
      <h2 class="title">Four house colours.</h2>
      <span class="meta">Custom RAL on request</span>
    </header>

    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line);">
      <div style="background: var(--bone); padding: var(--s-5);">
        <div style="aspect-ratio: 1; background: #1A1A1A; margin-bottom: var(--s-3);"></div>
        <strong class="serif" style="font-size: 1.1rem;">Black</strong><br/>
        <span class="label">RAL 9005</span>
      </div>
      <div style="background: var(--bone); padding: var(--s-5);">
        <div style="aspect-ratio: 1; background: #3A3A3A; margin-bottom: var(--s-3);"></div>
        <strong class="serif" style="font-size: 1.1rem;">Dark Grey</strong><br/>
        <span class="label">RAL 7016</span>
      </div>
      <div style="background: var(--bone); padding: var(--s-5);">
        <div style="aspect-ratio: 1; background: #F5F5F0; margin-bottom: var(--s-3); border: 1px solid var(--line);"></div>
        <strong class="serif" style="font-size: 1.1rem;">Traffic White</strong><br/>
        <span class="label">RAL 9016</span>
      </div>
      <div style="background: var(--bone); padding: var(--s-5);">
        <div style="aspect-ratio: 1; background: #E8DFCD; margin-bottom: var(--s-3);"></div>
        <strong class="serif" style="font-size: 1.1rem;">Cream</strong><br/>
        <span class="label">RAL 9001</span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 16ch; margin-inline: auto;">Free survey, in your garden.</h2>
    <p class="lede mt-5" style="margin-inline: auto;">
      We'll measure, we'll talk through options, we'll bring physical samples — and we'll leave.
      No pressure, no salesman tricks.
    </p>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href="/contact/">Book a free survey <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://configurator.alfresko.co.uk/?dealerId=0c65eea4-80d9-4a26-b81f-0ef4e0659bd9" target="_blank" rel="noopener">Instant Price <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="tel:02475102899">024 7510 2899</a>
    </div>
  </div>
</section>

</Base>
