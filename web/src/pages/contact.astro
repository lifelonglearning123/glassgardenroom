---
import Base from '~/layouts/Base.astro';
import { fetchOne } from '~/lib/sanity';
import { siteSettingsQuery, contactPageQuery } from '~/lib/queries';
import { renderInline, renderRichText } from '~/lib/portableText';
import type { SiteSettings } from '~/types';

const [settings, page] = await Promise.all([
  fetchOne<SiteSettings>(siteSettingsQuery),
  fetchOne<any>(contactPageQuery),
]);

const head = page?.pageHead;
const breadcrumb = head?.breadcrumb  ?? '— Visit & Contact';
const labelMid   = head?.label       ?? 'Free consultation · No obligation';
const labelRight = 'Reply within 24h';
const headline   = head?.headline ? renderInline(head.headline) : 'Begin with a <em>conversation.</em>';
const lede       = head?.lede ?? "Send us a message, give us a call, or visit our Nuneaton showroom by appointment. We'll come back with an honest quote and an unhurried plan — no pressure, no salesman tricks.";

const successMsg = page?.formBlock?.successMessage ?? "Thank you — your enquiry is with us. We'll reply within 2 working days.";

const phone = settings?.phone ?? '024 7510 2899';
const wa    = '07398 224061';
const email = settings?.email ?? 'info@glassgardenrooms.net';
const addr  = settings?.address;
const fullAddress = addr
  ? `${addr.line1 ?? ''}${addr.line1 ? ', ' : ''}${addr.town ?? ''}${addr.postcode ? ', ' + addr.postcode : ''}`
  : 'Unit 25, Centenary Business Centre, Hammond Close, Nuneaton, CV11 6RY';
const mapUrl = addr?.mapUrl ?? 'https://www.google.com/maps?q=Centenary+Business+Centre,+Hammond+Close,+Nuneaton+CV11+6RY&output=embed';

const hours = settings?.showroomHours?.length ? settings.showroomHours : [
  { days: 'Monday – Friday', hours: '8am – 6pm' },
  { days: 'Saturday',        hours: 'Closed' },
  { days: 'Sunday',          hours: 'Closed' },
];

const pageTitle = page?.seo?.title ?? 'Visit & Contact | Glass Garden Rooms';
const pageDesc  = page?.seo?.description ?? `Visit our Nuneaton showroom by appointment, or send us a message. Phone ${phone}, WhatsApp ${wa}. Reply within 2 working days.`;
---
<Base title={pageTitle} description={pageDesc} seo={page?.seo} settings={settings}>

<section class="page-head wrap">
  <div class="page-head-row">
    <span class="breadcrumb">{breadcrumb}</span>
    <span class="label" style="text-align:center;">{labelMid}</span>
    <span class="label">{labelRight}</span>
  </div>
  <h1 set:html={headline} />
  <p class="lede">{lede}</p>
</section>

<section class="section wrap">
  <div class="editorial">
    <form class="reveal" id="quote-form" novalidate>
      <span class="eyebrow">Request a quote</span>
      <div class="form-grid" style="margin-top: var(--s-5);">
        <div class="field">
          <label for="f-name">Full name</label>
          <input id="f-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="f-phone">Phone</label>
          <input id="f-phone" name="phone" type="tel" required autocomplete="tel" />
        </div>
        <div class="field field-full">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="f-product">Interested in</label>
          <select id="f-product" name="product">
            <option>The Provence (glass veranda)</option>
            <option>The Bordeaux (polycarbonate veranda)</option>
            <option>Premium Glass Garden Room</option>
            <option>The hup! extension system</option>
            <option>Carport / canopy</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="f-postcode">Postcode</label>
          <input id="f-postcode" name="postcode" type="text" autocomplete="postal-code" />
        </div>
        <div class="field field-full">
          <label for="f-budget">Budget <small style="color: var(--ink-mute); font-weight: 400; letter-spacing: 0; text-transform: none;">— how much you're prepared to spend</small></label>
          <select id="f-budget" name="budget" required>
            <option value="">Please choose a range…</option>
            <option value="Under £3,000">Under £3,000</option>
            <option value="£3,000 – £5,000">£3,000 – £5,000</option>
            <option value="£5,000 – £10,000">£5,000 – £10,000</option>
            <option value="£10,000 – £20,000">£10,000 – £20,000</option>
            <option value="£20,000 – £40,000">£20,000 – £40,000</option>
            <option value="£40,000+">£40,000+</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>
        <div class="field field-full">
          <label for="f-message">Tell us about your space</label>
          <textarea id="f-message" name="message" placeholder="Width, projection, wall material, anything you'd like us to know..." required></textarea>
        </div>
        <div class="field-full">
          <p id="quote-status" class="form-status" role="status" aria-live="polite" hidden data-success-msg={successMsg}></p>
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Send message <span class="arrow">→</span>
          </button>
        </div>
      </div>
    </form>

    <div class="reveal" style="display: flex; flex-direction: column; gap: var(--s-5);">
      <div class="contact-card">
        <span class="eyebrow">Direct lines</span>
        <div class="contact-row"><span class="k">Telephone</span><a href={`tel:${phone.replace(/\s/g, '')}`} class="v">{phone}</a></div>
        <div class="contact-row"><span class="k">WhatsApp</span><a href={`https://wa.me/44${wa.replace(/\s/g, '').replace(/^0/, '')}`} class="v italic">{wa}</a></div>
        <div class="contact-row"><span class="k">Email</span><a href={`mailto:${email}`} class="v">{email}</a></div>
      </div>

      <div class="contact-card">
        <span class="eyebrow">Office &amp; visits</span>
        <div class="contact-row">
          <span class="k">Office and Showroom</span>
          <span class="v" style="font-size: 1.05rem; line-height: 1.4;">{fullAddress}</span>
        </div>
      </div>

      <div class="contact-card">
        <span class="eyebrow">Hours</span>
        <div style="display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 2rem; font-size: 0.95rem;">
          {hours.map((h) => (<>
            <span>{h.days}</span>
            <span class="serif" style="font-style: italic; color: var(--moss);">{h.hours}</span>
          </>))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <header class="section-head">
      <span class="num">№ 02</span>
      <h2 class="title">Find the showroom.</h2>
      <span class="meta">{addr?.postcode ? `${addr?.town ?? 'Nuneaton'}, ${addr.postcode}` : 'Nuneaton, CV11 6RY'}</span>
    </header>
    <div style="aspect-ratio: 21/9; max-height: 60vh; overflow: hidden; background: var(--bone-deep); border: 1px solid var(--line);">
      <iframe
        src={mapUrl}
        width="100%"
        height="100%"
        style="border:0; filter: grayscale(0.45) contrast(1.05);"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Glass Garden Rooms — Nuneaton office"
      ></iframe>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap text-center">
    <h2 class="display" style="max-width: 18ch; margin-inline: auto;">Or just <em class="italic-display">phone</em> us.</h2>
    <p class="lede mt-5" style="margin-inline: auto;">Sometimes the fastest way is the oldest one. We'll pick up between 8 and 6, Monday to Friday.</p>
    <div class="flex gap-3 flex-wrap mt-6" style="justify-content: center;">
      <a class="btn btn-primary" href={`tel:${phone.replace(/\s/g, '')}`}>Call {phone} <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href={`https://wa.me/44${wa.replace(/\s/g, '').replace(/^0/, '')}`}>WhatsApp instead</a>
    </div>
  </div>
</section>

</Base>
