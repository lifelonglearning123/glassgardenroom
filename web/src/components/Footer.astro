---
import type { SiteSettings } from '~/types';
interface Props { settings: SiteSettings | null; }
const { settings } = Astro.props;

const tagline = settings?.footer?.tagline
  ?? 'A family of designers, makers and installers based in Nuneaton — building quiet, well-made aluminium architecture across the Midlands and beyond.';
const legal = settings?.footer?.legalLine
  ?? '© 2026 Glass Garden Rooms Ltd · Co. No. 15487442';
const regline = 'Introducer regulated by the FCA · Finance via Ideal4Finance (FRN 703401)';

const columns = settings?.footer?.columns ?? [
  {
    heading: 'Catalogue',
    links: [
      { label: 'Verandas',       href: '/verandas/' },
      { label: 'Garden Rooms',   href: '/garden-rooms/' },
      { label: 'Carports',       href: '/carports/' },
      { label: 'All Products',   href: '/products/' },
      { label: 'Brochure (PDF)', href: '/assets/glass-garden-rooms-brochure.pdf' },
    ],
  },
  {
    heading: 'Service',
    links: [
      { label: 'Installation', href: '/installation/' },
      { label: 'Finance',      href: '/finance/' },
      { label: 'FAQ',          href: '/faq/' },
      { label: 'Contact',      href: '/contact/' },
    ],
  },
];

const phone   = settings?.phone   ?? '024 7510 2899';
const wa      = '07398 224061';
const email   = settings?.email   ?? 'info@glassgardenrooms.net';
const addr    = settings?.address;
const addrL1  = addr?.line1   ?? 'Unit 25, Centenary Business Centre,';
const addrL2  = `${addr?.town ?? 'Hammond Close, Nuneaton'}${addr?.postcode ? ', ' + addr.postcode : ', CV11 6RY'}`;
---
<footer class="colophon">
  <div class="wrap">
    <div class="colophon-grid">
      <div class="colophon-brand">
        <p class="display">Bring the<br/><em>outdoors</em> in.</p>
        <p>{tagline}</p>
      </div>
      {columns.map((col) => (
        <div>
          <h4>{col.heading}</h4>
          <ul class="colophon-list">
            {col.links?.map((link: any) => (
              <li>
                <a
                  href={link.href}
                  download={link.href?.endsWith('.pdf') ? '' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h4>Find us</h4>
        <ul class="colophon-list">
          <li><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></li>
          <li><a href={`https://wa.me/44${wa.replace(/\s/g, '').replace(/^0/, '')}`}>WhatsApp {wa}</a></li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li>{addrL1}<br/>{addrL2}</li>
        </ul>
      </div>
    </div>
    <div class="colophon-bottom">
      <span>{legal}</span>
      <span>{regline}</span>
    </div>
  </div>
</footer>
