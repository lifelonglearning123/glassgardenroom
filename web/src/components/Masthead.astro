---
import type { SiteSettings } from '~/types';
interface Props { settings: SiteSettings | null; currentPath: string; }
const { settings, currentPath } = Astro.props;

const fallbackNav = [
  { label: 'Products',     href: '/products/' },
  { label: 'Installation', href: '/installation/' },
  { label: 'Finance',      href: '/finance/' },
  { label: 'Journal',      href: '/journal/' },
  { label: 'Visit',        href: '/contact/' },
];
const nav      = settings?.masthead?.nav?.length ? settings.masthead.nav : fallbackNav;
const ctaLabel = settings?.masthead?.ctaLabel ?? 'Request a quote';
const ctaHref  = settings?.masthead?.ctaHref  ?? '/contact/';
const logoUrl  = settings?.masthead?.logo?.url ?? '/Brand/glassgardenroom.co-logo.svg';
const logoAlt  = settings?.masthead?.logo?.alt ?? 'Glass Garden Rooms';

const isCurrent = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---
<header class="masthead">
  <div class="masthead-inner">
    <a class="logo" href="/" aria-label="Glass Garden Rooms — home">
      <img src={logoUrl} alt={logoAlt} width="180" height="45" />
    </a>
    <nav class="primary-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class={isCurrent(item.href) ? 'is-current' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="cta-mini" href={ctaHref}>
      {ctaLabel} <span class="arrow">→</span>
    </a>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 1h20M0 7h20M0 13h12" stroke="currentColor" stroke-width="1.4"/>
      </svg>
    </button>
  </div>
</header>
