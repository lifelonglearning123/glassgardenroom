{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html",        "destination": "/",                "permanent": true },
    { "source": "/verandas.html",     "destination": "/verandas/",       "permanent": true },
    { "source": "/garden-rooms.html", "destination": "/garden-rooms/",   "permanent": true },
    { "source": "/carports.html",     "destination": "/carports/",       "permanent": true },
    { "source": "/products.html",     "destination": "/products/",       "permanent": true },
    { "source": "/installation.html", "destination": "/installation/",   "permanent": true },
    { "source": "/finance.html",      "destination": "/finance/",        "permanent": true },
    { "source": "/faq.html",          "destination": "/faq/",            "permanent": true },
    { "source": "/contact.html",      "destination": "/contact/",        "permanent": true },
    { "source": "/blog.html",         "destination": "/journal/",        "permanent": true },
    { "source": "/blog/glass-or-polycarbonate.html", "destination": "/journal/glass-or-polycarbonate/", "permanent": true },
    { "source": "/blog/the-river-house.html",        "destination": "/journal/the-river-house/",        "permanent": true },
    { "source": "/blog/why-aluminium.html",          "destination": "/journal/why-aluminium/",          "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico|woff2|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
