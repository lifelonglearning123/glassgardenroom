# Copy to .env.local for local dev. On Vercel, add these under Project -> Settings -> Environment Variables.

# --- Sign-in ---------------------------------------------------------------
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# The first account is created from these on the first sign-in attempt.
# After that, add or change users on the Settings page.
ADMIN_EMAIL=info@glassgardenrooms.net
ADMIN_PASSWORD=
ADMIN_NAME=Steve

# --- Database --------------------------------------------------------------
# Postgres connection string (Vercel -> Storage -> Neon). Leave empty locally
# to store everything in ./data/store.json instead.
DATABASE_URL=

# --- Photo uploads ---------------------------------------------------------
# Vercel Blob token (Vercel -> Storage -> Blob). Needed for uploads on Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Nexus Portal ----------------------------------------------------------
# Nothing to set here: connect Nexus Portal from the app (Quotes > Settings).
# The access token is stored encrypted in the database using AUTH_SECRET.

# --- App -------------------------------------------------------------------
# Public address of the site, used in proposal links emailed to clients.
APP_URL=https://www.glassgardenrooms.net
# Next quote number to issue (continues Steve's Word numbering).
QUOTE_START_NUMBER=393
